# Copy this file to config.sh (same directory) and fill in your own values.
# config.sh is git-ignored - your callsign, grid square, radio serial ID, and
# any credentials you fill in below never end up in version control.

# ---- Identity (used by Pat Winlink / VARA) ----
CALLSIGN="N0CALL"
GRID="AA00aa"
WINLINK_PASSWORD=""            # your Winlink.org account password
VARA_REG_CODE=""               # shared across VARA HF and VARA FM
VARA_CALLSIGN_LICENSE="N0CALL" # the callsign your VARA registration covers

# ---- IC-705 / Wine ham stack ----
AUDIO_DEVICE="hw:CODEC,0"      # card's stable ID string (aplay -l / /proc/asound/cards), not a raw index - those shift across reboots/replugs
IC705_SERIAL_ID="usb-Icom_Inc._IC-705_IC-705_XXXXXXXX-if00"  # ls /dev/serial/by-id/
DOWNLOADS="$HOME/Downloads"
WINEPREFIX_HAM="$HOME/.wine32"

# ---- Convenience options (all optional, off by default) ----
# "yes": the JS8Call Desktop icon also opens CommStat once JS8Call is up (CommStat connects to JS8Call
# at its own start-up, so it has to come second). "no" (or blank): JS8Call opens alone and you start
# CommStat yourself. Applied when Setup_Ham_Radio_Stack.sh (re)generates Start_JS8Call.sh.
JS8CALL_OPENS_COMMSTAT="no"
# "yes": for a machine used ONLY for AmRRON - the Fldigi and Flamp launchers re-apply AmRRON's
# settings (AFC off, Contestia 4/250 at 900 Hz, Flamp options...) on EVERY start. "no" (default):
# applied once per profile, then left alone so your own changes stick.
AMRRON_ALWAYS_APPLY="no"

# ---- RTL-SDR / ADS-B station location (optional) ----
# Leave both blank to skip setting a fixed location - readsb will just use
# GPS (if a USB GPS is plugged in and gpsd auto-detects it) or no location.
ADSB_LAT=""                    # e.g. 40.0637
ADSB_LON=""                    # e.g. -74.9868

# The official ADS-B Exchange installer auto-generates a feeder/site name
# from your location that isn't reliably correct, and if you run more than
# one feeder (e.g. a laptop and a desktop station), each one needs its own
# unique name - reusing the same name across two active feeders makes them
# indistinguishable on the sync check/MLAT map. Leave blank to just keep
# whatever the installer picks. See "Hard-won lessons" in README.md.
ADSB_FEEDER_NAME=""            # e.g. "EE-KPHL-DESKTOP" - must be unique per feeder
